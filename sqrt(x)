class Solution {
    public int mySqrt(int x) {
        int n =x/2;
        long left=0;
        long right=n;
        if(x==1) return 1;
        if(x==0) return 0;
        while(left<=right){
            long mid = left+(right - left) / 2;
            long square =mid*mid;
            if(x==square){
                return (int)mid;
            }
            else if (square<x){
                left=mid+1;
            }
            else{
                right=mid-1;
            }

        }
        return (int)right;

    }
}
